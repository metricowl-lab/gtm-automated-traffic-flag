___TESTS___

scenarios:
- name: An ordinary browser returns nothing
  code: |-
    mock('copyFromWindow', function (k) { return k === 'navigator.webdriver' ? false : 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36'; });
    assertThat(runCode({output: 'label'})).isUndefined();
    assertThat(runCode({output: 'label', otherValue: 'human'})).isEqualTo('human');
    assertThat(runCode({output: 'boolean'})).isFalse();
- name: Automation is flagged even with a normal user agent
  code: |-
    mock('copyFromWindow', function (k) { return k === 'navigator.webdriver' ? true : 'Mozilla/5.0 Chrome/130.0'; });
    assertThat(runCode({output: 'label'})).isEqualTo('automated');
    assertThat(runCode({output: 'boolean'})).isTrue();
- name: Headless Chrome is flagged
  code: |-
    mock('copyFromWindow', function (k) { return k === 'navigator.webdriver' ? undefined : 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/130.0 Safari/537.36'; });
    assertThat(runCode({output: 'label'})).isEqualTo('headless');
- name: Crawlers and monitoring tools are flagged
  code: |-
    mock('copyFromWindow', function (k) { return k === 'navigator.webdriver' ? false : 'Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)'; });
    assertThat(runCode({output: 'label'})).isEqualTo('crawler');
    mock('copyFromWindow', function (k) { return k === 'navigator.webdriver' ? false : 'Mozilla/5.0 (X11; Linux x86_64) Chrome/130.0 Safari/537.36 Chrome-Lighthouse'; });
    assertThat(runCode({output: 'label'})).isEqualTo('crawler');
- name: Phones with bot in the name aren't flagged
  code: |-
    mock('copyFromWindow', function (k) { return k === 'navigator.webdriver' ? false : 'Mozilla/5.0 (Linux; Android 10; CUBOT X30 Build/QP1A) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Mobile Safari/537.36'; });
    assertThat(runCode({output: 'label'})).isUndefined();
- name: Unlisted crawlers with a +http link are flagged
  code: |-
    mock('copyFromWindow', function (k) { return k === 'navigator.webdriver' ? false : 'Mozilla/5.0 (compatible; ExampleIndexer/1.0; +https://example.com/indexer)'; });
    assertThat(runCode({output: 'label'})).isEqualTo('crawler');
- name: Google's URL inspection tool is flagged
  code: |-
    mock('copyFromWindow', function (k) { return k === 'navigator.webdriver' ? false : 'Mozilla/5.0 (Linux; Android 6.0.1; Nexus 5X Build/MMB29P) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Mobile Safari/537.36 (compatible; Google-InspectionTool/1.0)'; });
    assertThat(runCode({output: 'label'})).isEqualTo('crawler');
- name: A missing user agent is treated as ordinary
  code: |-
    mock('copyFromWindow', undefined);
    assertThat(runCode({output: 'label'})).isUndefined();


