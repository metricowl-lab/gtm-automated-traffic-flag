___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const copyFromWindow = require('copyFromWindow');
const makeString = require('makeString');

// navigator.webdriver is true when a browser is controlled by automation, such as Selenium,
// Puppeteer or Playwright. The user agent catches headless browsers and declared crawlers.
const HEADLESS = ['headlesschrome', 'phantomjs', 'slimerjs'];
// Crawlers and testing tools that can run JavaScript, so can fire tags, plus '+http', which crawlers
// put in their user agent to link to their documentation and ordinary browsers never do. A plain
// 'bot' match would catch phones such as CUBOT. Tools that never run JavaScript (curl, link preview
// fetchers and so on) can't fire tags, so they aren't listed.
const CRAWLERS = ['+http', 'googlebot', 'google-inspectiontool', 'bingbot', 'yandexbot', 'baiduspider',
  'duckduckbot', 'applebot', 'ahrefsbot', 'semrushbot', 'petalbot', 'gptbot', 'chatgpt-user', 'oai-searchbot',
  'claudebot', 'perplexitybot', 'bytespider', 'amazonbot', 'crawler', 'spider', 'slurp', 'lighthouse',
  'pagespeed', 'gtmetrix', 'pingdom', 'uptimerobot'];

const contains = function (text, list) {
  for (let i = 0; i < list.length; i++) if (text.indexOf(list[i]) > -1) return true;
  return false;
};

let label;
if (copyFromWindow('navigator.webdriver') === true) label = 'automated';
else {
  const ua = makeString(copyFromWindow('navigator.userAgent') || '').toLowerCase();
  if (contains(ua, HEADLESS)) label = 'headless';
  else if (contains(ua, CRAWLERS)) label = 'crawler';
}

if (data.output === 'boolean') return !!label;
if (label) return label;
return data.otherValue ? data.otherValue : undefined;


